# PROPOSED, NOT ACTIVE. Move to .github/workflows/ios-ci.yml only after Ben approves.
# macOS runner minutes are billed at a multiplier on private repos; check current GitHub pricing first.
name: ios-ci
on:
  pull_request:
  workflow_dispatch:
jobs:
  verify:
    runs-on: macos-latest
    timeout-minutes: 30
    steps:
      - uses: actions/checkout@v4   # pin to a commit SHA when activating
      - run: scripts/verify.sh --ci all || [ $? -eq 2 ]   # --ci: only the manual device check may be NOT VERIFIED
