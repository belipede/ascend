{
  "permissions": {
    "deny": [
      "Read(./**/*.p12)",
      "Read(./**/*.p8)",
      "Read(./**/*.mobileprovision)",
      "Read(./**/.env)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -fd:*)",
      "Bash(xcrun altool:*)",
      "Bash(xcrun notarytool:*)"
    ],
    "ask": [
      "Edit(./**/*.entitlements)",
      "Write(./**/*.entitlements)",
      "Bash(git push:*)",
      "Bash(xcodebuild -exportArchive:*)",
      "Bash(xcodebuild archive:*)"
    ]
  }
}
