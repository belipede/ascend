{
  "permissions": {
    "deny": [
      "Read(./**/*.p12)",
      "Read(./**/*.p8)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/*.cer)",
      "Read(./**/*.mobileprovision)",
      "Read(./**/*.provisionprofile)",
      "Read(./**/.env)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(git checkout -- .:*)",
      "Bash(git restore .:*)",
      "Bash(rm -rf:*)",
      "Bash(rm -fr:*)",
      "Bash(xcrun altool:*)",
      "Bash(xcrun notarytool:*)"
    ],
    "ask": [
      "Edit(./**/*.entitlements)",
      "Edit(./**/*.pbxproj)",
      "Bash(git push:*)",
      "Bash(xcodebuild -exportArchive:*)",
      "Bash(xcodebuild archive:*)"
    ]
  }
}
